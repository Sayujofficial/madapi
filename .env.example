# API Keys - Copy this file to .env and add your actual API keys

# Google Maps API Key (get from Google Cloud Console)
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeather API Key (get from openweathermap.org)
REACT_APP_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Gemini AI API Key (get from Google AI Studio)
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here

# WAQI Token (get from aqicn.org/data-platform/token/)
REACT_APP_WAQI_TOKEN=your_waqi_token_here